<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop head: the Windows/macOS/Linux entry point. Hosts the shared Fluid.Avalonia.Demo
       library's App in a classic desktop lifetime. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>..\Fluid.Avalonia.Demo\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Fluid.Avalonia.Demo\Assets\logo.ico</ApplicationIcon>
    <RootNamespace>Fluid.Avalonia.Demo</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <FluidAvaloniaNativeAotDemo>true</FluidAvaloniaNativeAotDemo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <!-- Avalonia hot reload — live .axaml / .cs edits in the running app (Avalonia 12.1's GA feature).
       It is COMMERCIAL: the package requires a licence key (Avalonia Plus / Pro / Enterprise, or the
       30-day community trial), and without one the BUILD fails with AvaloniaUI.Licensing AVLIC0001.
       So it is strictly opt-in and Debug-only — a plain build, and CI, never reference it:

           dotnet watch run -p:FluidAvaloniaHotReload=true -p:AvaloniaUILicenseKey=<key>

       The key may equally come from an environment variable or a CI secret; never commit one. No
       startup code is needed: the package's source generator wires itself up, and its targets pull
       the .axaml of referenced projects (the shared Fluid.Avalonia.Demo library, and the theme) into
       its registry, so edits anywhere in the solution apply. Add
       AvaloniaHotReloadEnableFileWatcher=true to also pick up .axaml edits when running outside
       `dotnet watch`.

       This does NOT replace the demo's Playground page: that is a runtime XAML sandbox for the app's
       own users (Avalonia.Markup.Xaml.Loader, and it ships in the WASM demo), whereas hot reload is a
       developer-time tool driven by `dotnet watch` or an IDE. -->
  <ItemGroup Condition="'$(FluidAvaloniaHotReload)' == 'true' And '$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport.HotReload" Version="1.0.1" />
    <AvaloniaUILicenseKey Include="$(AvaloniaUILicenseKey)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Flow the NativeAOT flag into the shared Demo project ONLY when this head is actually
         published AOT (Release + RuntimeIdentifier). In a plain solution build the flag is unset,
         so Demo must be referenced with the SAME (empty) global properties here as from the Browser
         head and the solution itself — otherwise MSBuild builds Demo twice into the same obj/ and
         the two builds race on its output (AVLN9999 / "being used by another process"). -->
    <ProjectReference Include="..\Fluid.Avalonia.Demo\Fluid.Avalonia.Demo.csproj"
                      Condition="'$(FluidAvaloniaNativeAotDemo)' == 'true'"
                      AdditionalProperties="FluidAvaloniaNativeAotDemo=true" />
    <ProjectReference Include="..\Fluid.Avalonia.Demo\Fluid.Avalonia.Demo.csproj"
                      Condition="'$(FluidAvaloniaNativeAotDemo)' != 'true'" />
  </ItemGroup>

</Project>
